---
import "../styles/global.css";
import Nav from "../components/site/Nav.astro";
import Footer from "../components/site/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Full-bleed pages (the hero) manage their own top spacing. */
  bleed?: boolean;
}

const {
  title,
  description = "Shuttlers United — a badminton club in Dimapur, Nagaland. Member profiles, tournament results and membership.",
  bleed = false,
} = Astro.props;

const fullTitle =
  title === "Shuttlers United" ? title : `${title} · Shuttlers United`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const { member, isAdmin } = Astro.locals;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="theme-color"
      content="#0a0e1a"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />

    {
      /* Resolve the theme before first paint. The class ships as `dark` on the
 server render, so this only ever has to *remove* it — no flash of dark
 for someone who chose light. */
    }
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("su-theme");
        } catch {
          /* private browsing */
        }
        // Dark is the default: only an explicit'light' choice, or a first
        // visit on a light-set OS, turns it off.
        const light =
          stored === "light" ||
          (stored === null &&
            window.matchMedia("(prefers-color-scheme: light)").matches);
        document.documentElement.classList.toggle("dark", !light);
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400&family=Outfit:wght@600&display=swap"
    />
  </head>

  <body class="flex min-h-screen flex-col bg-canvas">
    <a
      href="#main"
      class="sr-only rounded-md bg-ink px-3.5 py-2 label-sm text-on-ink focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50"
    >
      Skip to content
    </a>

    <Nav member={member} isAdmin={isAdmin} />

    <main id="main" class={bleed ? "flex-1" : "flex-1 py-12 md:py-16"}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
