---
import AppLayout from "../../layouts/AppLayout.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import Empty from "../../components/ui/Empty.astro";
import { actions } from "astro:actions";
import { getAdminClient } from "../../lib/pocketbase";
import { shortDate, minuteToTime, dateKey } from "../../lib/format";
import type { Booking } from "../../lib/types";

const pb = await getAdminClient();
const today = dateKey();

// Everything from today onward — a past booking isn't actionable.
const bookings = await pb.collection("bookings").getFullList<Booking>({
  filter: pb.filter("date >= {:today}", { today: `${today} 00:00:00` }),
  expand: "court,member",
  sort: "date,start_minute",
});
---

<AppLayout
  section="admin"
  title="Bookings"
  eyebrow="Club administration"
  heading="Court bookings"
  description="Every upcoming reservation across all courts."
>
  {
    bookings.length === 0 ? (
      <Empty title="Nothing booked">
        Upcoming court reservations will appear here.
      </Empty>
    ) : (
      <Card padding="none">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[680px] border-collapse text-left">
            <thead>
              <tr class="border-b border-hairline-soft">
                {["Date", "Time", "Court", "Member", "Status", ""].map(
                  (heading) => (
                    <th class="px-4 py-3 tracking-[0.06em] text-[12px] font-medium uppercase leading-4 text-mute">
                      {heading}
                    </th>
                  ),
                )}
              </tr>
            </thead>
            <tbody>
              {bookings.map((booking) => (
                <tr class="border-b border-hairline-soft last:border-0">
                  <td class="px-4 py-3 text-[12px] leading-4 text-body">
                    {shortDate(booking.date)}
                  </td>
                  <td class="px-4 py-3 text-[12px] leading-4 text-ink">
                    {minuteToTime(booking.start_minute)}–
                    {minuteToTime(booking.end_minute)}
                  </td>
                  <td class="px-4 py-3 text-[14px] leading-5 text-ink">
                    {booking.expand?.court?.name ?? "—"}
                  </td>
                  <td class="px-4 py-3 text-[14px] leading-5 text-body">
                    {booking.expand?.member?.name ?? "—"}
                  </td>
                  <td class="px-4 py-3">
                    <Badge
                      tone={
                        booking.status === "cancelled" ? "error" : "success"
                      }
                    >
                      {booking.status}
                    </Badge>
                  </td>
                  <td class="px-4 py-3 text-right">
                    {booking.status === "confirmed" && (
                      <form method="POST" action={actions.admin.cancelBooking}>
                        <input type="hidden" name="id" value={booking.id} />
                        <button
                          type="submit"
                          class="rounded-md border border-hairline px-2.5 py-1 text-[12px] leading-4 text-body transition-colors hover:border-error/30 hover:text-error"
                        >
                          Cancel
                        </button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    )
  }
</AppLayout>
