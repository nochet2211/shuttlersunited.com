---
/**
 * Temporary landing page for the 9th Dimapur District Interclub, which the
 * club is organising. The newsroom that normally lives here has moved to /news
 * for the duration; when the tournament is over, delete this file and move
 * src/pages/news/index.astro back here.
 *
 * The poster carries the event's own artwork, so the page around it stays
 * quiet: no gradient mesh, no indigo, just the details in real text so they
 * can be read, searched and copied. Phones get the portrait poster, whose
 * lettering survives a narrow screen; wider screens get the landscape banner.
 */
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import CommitteeCarousel from "../components/event/CommitteeCarousel.astro";
import banner from "../assets/interclub-2026.jpeg";
import portrait from "../assets/interclub-2026-portrait.jpeg";

const event = {
  name: "9th Dimapur District Interclub Badminton Tournament 2026",
  dates: "27–28 November 2026",
  venue: "Livingstone Foundation College Indoor Stadium",
  locality: "Landmark Colony, Dimapur",
  organiser:
    "Shuttlers United, under the aegis of the Dimapur District Badminton Association",
  memorial: "Late Shri. Mayang Lima",
  partners: ["State Bank of India", "Anil Steel"],
  categories: [
    "75+ (min age 35)",
    "85+ (min age 40)",
    "95+ (min age 45)",
    "105+ (min age 45)",
  ],
  prizes: "Rs. 72,000 in total, plus certificates, medals and souvenirs",
};

// Status is worked out on Dimapur's calendar, not the server's, so the line
// flips at local midnight.
const today = new Intl.DateTimeFormat("en-CA", {
  timeZone: "Asia/Kolkata",
}).format(new Date());
const daysToGo = Math.round(
  (Date.parse("2026-11-27") - Date.parse(today)) / 86_400_000,
);
const status =
  today > "2026-11-28"
    ? "Concluded"
    : daysToGo <= 0
      ? "Happening now"
      : daysToGo === 1
        ? "Starts tomorrow"
        : `Starts in ${daysToGo} days`;

// The committee cards, in the order the club supplied them. Each name and role
// is copied from its card, so the alt text says what the image says.
const cards = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/committee/*.jpeg",
  { eager: true },
);
const committee = [
  { name: "Tali Pongener", role: "Convenor, Planning Committee" },
  { name: "Moanungsang", role: "Member, Planning Committee" },
  { name: "Temjentoshi Jamir", role: "Member, Planning Committee" },
  { name: "Bendangnungsang Ao", role: "Fin. Secy., Shuttlers United" },
  { name: "Richard A", role: "Member, Planning Committee" },
  { name: "Dr. Chubakumzuk Longchar", role: "Treasurer, Shuttlers United" },
  { name: "Raj Kumar Das", role: "Member, Planning Committee" },
  { name: "P Bendangmongba", role: "Fin. Secy., Planning Committee" },
  { name: "Dr. Imkongkumzuk", role: "Member, Planning Committee" },
  { name: "Repentsung", role: "Member, Planning Committee" },
  { name: "Temjennungsang", role: "Finance, Shuttlers United" },
  { name: "Temjen Lemtur", role: "Secretary, Planning Committee" },
  { name: "Imlitemjen", role: "Finance, Shuttlers United" },
  { name: "Dr. I Allong Nikdir", role: "Medical/Physio, Shuttlers United" },
].map((person, index) => ({
  ...person,
  image:
    cards[`../assets/committee/${String(index + 1).padStart(2, "0")}.jpeg`]
      .default,
}));

const details = [
  { term: "Dates", value: event.dates },
  { term: "Venue", value: `${event.venue}, ${event.locality}` },
  { term: "Categories", value: event.categories },
  { term: "Prize money", value: event.prizes },
  { term: "Organised by", value: event.organiser },
  { term: "Event partners", value: event.partners.join(" · ") },
];

// Art direction: <Picture> serves one image at many sizes, but this needs two
// different crops, so the <picture> is assembled by hand from getImage().
const crops = [
  { media: "(max-width: 639px)", image: portrait, widths: [480, 899] },
  { media: undefined, image: banner, widths: [1024, 1600] },
];
const sources = await Promise.all(
  crops.flatMap((crop) =>
    (["avif", "webp"] as const).map(async (format) => {
      const { srcSet } = await getImage({
        src: crop.image,
        format,
        widths: crop.widths,
      });
      return {
        media: crop.media,
        type: `image/${format}`,
        srcset: srcSet.attribute,
        // Per-source dimensions, so a phone reserves the portrait's height.
        width: crop.image.width,
        height: crop.image.height,
      };
    }),
  ),
);
const fallback = await getImage({ src: banner, format: "jpg", width: 1600 });
---

<Layout
  title="Interclub 2026"
  description={`${event.name} — ${event.dates} at ${event.venue}, ${event.locality}. Organised by Shuttlers United.`}
  bleed
>
  <section class="shell pt-6 md:pt-10">
    <figure class="card overflow-hidden p-0">
      <picture>
        {
          sources.map((source) => (
            <source {...source} sizes="(min-width: 1280px) 1200px, 100vw" />
          ))
        }
        <img
          src={fallback.src}
          width={banner.width}
          height={banner.height}
          alt={`${event.name}, organised by Shuttlers United under the aegis of DDBA, in memory of ${event.memorial}. ${event.dates}, ${event.venue}, ${event.locality}. Categories ${event.categories.join(", ")}. Total prize money Rs. 72,000. Event partners: SBI and Anil Steel.`}
          class="block h-auto w-full"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
    </figure>
  </section>

  {
    /* On wide screens the details card spans both rows of the right column,
       and the committee fills the left column under the intro, so neither
       side leaves a hole. The card stretches to the column's height and its
       rows share the extra space, so both columns end on the same line. Source order (intro, details, committee) is also
       the phone order. */
  }
  <section
    class="shell grid gap-8 pt-10 pb-20 md:pb-24 lg:grid-cols-[minmax(0,1fr)_380px] lg:grid-rows-[auto_1fr] lg:gap-x-12 lg:gap-y-14"
  >
    <div class="flex max-w-[60ch] flex-col gap-4">
      <Eyebrow>{status}</Eyebrow>
      <h1 class="heading-lg text-ink">{event.name}</h1>
      <p class="subtitle-md text-body">
        Clubs from across Dimapur meet for two days of interclub badminton,
        hosted by Shuttlers United in memory of {event.memorial}.
      </p>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <Button href="/tournaments/dimapur-interclub-2026" variant="primary"
          >See the draw</Button
        >
        <Button href="/news" variant="secondary">Club news</Button>
      </div>
    </div>

    <dl class="card flex flex-col divide-y divide-hairline-soft lg:row-span-2">
      {
        details.map((item) => (
          <div class="flex flex-col gap-1 px-5 py-4 lg:flex-1 lg:justify-center">
            <dt class="text-[12px] uppercase leading-4 tracking-[0.06em] text-mute">
              {item.term}
            </dt>
            {/* A list value gets one line per entry, so no item breaks mid-way. */}
            {[item.value].flat().map((line) => (
              <dd class="text-[15px] leading-6 text-ink">{line}</dd>
            ))}
          </div>
        ))
      }
    </dl>

    {
      /* -mb-2 cancels the track's scrollbar padding, so the cards' bottom edge
         is the one the details card lines up with. */
    }
    <div class="min-w-0 pt-6 lg:col-start-1 lg:-mb-2 lg:pt-0">
      <CommitteeCarousel title="Organising committee" people={committee} />
    </div>
  </section>
</Layout>
