---
import AppLayout from "../../layouts/AppLayout.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import Alert from "../../components/ui/Alert.astro";
import { actions } from "astro:actions";
import { duesStatusFor, listTournaments } from "../../lib/queries";
import { money, periodLabel, shortDate } from "../../lib/format";

// Middleware guarantees a member on /dashboard; this narrows the type.
const member = Astro.locals.member!;

const [dues, upcoming] = await Promise.all([
  duesStatusFor(member.id),
  listTournaments("upcoming"),
]);

const isWelcome = Astro.url.searchParams.get("welcome") === "1";
const firstName = member.name.split(" ")[0];
---

<AppLayout
  section="member"
  title="Dashboard"
  eyebrow={`Signed in as ${member.name}`}
  heading={isWelcome ? `Welcome, ${firstName}` : `Hello, ${firstName}`}
  description={isWelcome
    ? "Your profile is live. Settle this month’s dues and you’re fully set up."
    : undefined}
>
  <div class="flex flex-col gap-6">
    {
      isWelcome && (
        <Alert tone="success">
          Your profile is on the roster.{" "}
          <a href={`/members/${member.slug}`} class="underline">
            View it
          </a>
          .
        </Alert>
      )
    }

    {/* ------------------------------------------------------------- dues */}
    <Card padding="lg">
      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex flex-col gap-1.5">
          <div class="flex items-center gap-2">
            <h2 class="heading-md">Dues for {periodLabel(dues.period)}</h2>
            {
              dues.paid ? (
                <Badge tone="success">Paid</Badge>
              ) : (
                <Badge tone="warning">Due</Badge>
              )
            }
          </div>
          <p class="text-[14px] leading-5 text-body">
            {
              dues.paid && dues.payment
                ? `${money(dues.payment.amount)} settled${dues.payment.paid_at ? ` on ${shortDate(dues.payment.paid_at)}` : ""}.`
                : "Your membership dues for this month are outstanding."
            }
          </p>
        </div>

        <Button
          href="/dashboard/payments"
          variant={dues.paid ? "secondary" : "primary"}
          class="shrink-0"
        >
          {dues.paid ? "View receipts" : "Pay now"}
        </Button>
      </div>
    </Card>

    {/* ------------------------------------------------------ quick links */}
    <div class="grid gap-4 sm:grid-cols-2">
      <Card href={`/members/${member.slug}`} padding="lg">
        <div class="flex flex-col gap-1.5">
          <h3 class="heading-md">Your public profile</h3>
          <p class="text-[14px] leading-5 text-body">
            {
              member.is_public
                ? "Live on the roster. Add your gear and a photo to fill it out."
                : "Currently hidden. Make it public so members can find you."
            }
          </p>
        </div>
      </Card>

      <Card href="/dashboard/profile" padding="lg">
        <div class="flex flex-col gap-1.5">
          <h3 class="heading-md">Profile & gear</h3>
          <p class="text-[14px] leading-5 text-body">
            Update your details, upload a photo, and list the racket and tension
            you play with.
          </p>
        </div>
      </Card>
    </div>

    {
      upcoming.length > 0 && (
        <Card padding="none">
          <h2 class="border-b border-hairline-soft px-5 py-4 eyebrow">
            Tournaments coming up
          </h2>
          <ul class="divide-y divide-hairline-soft">
            {upcoming.slice(0, 3).map((event) => (
              <li>
                <a
                  href={`/tournaments/${event.slug}`}
                  class="flex items-center justify-between gap-4 px-5 py-3 transition-colors hover:bg-canvas"
                >
                  <span class="text-[14px] font-medium leading-5 text-ink">
                    {event.name}
                  </span>
                  <span class="shrink-0 eyebrow">
                    {shortDate(event.start_date)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </Card>
      )
    }

    <form method="POST" action={actions.auth.logout} class="pt-2">
      <button
        type="submit"
        class="text-[14px] leading-5 text-mute transition-colors hover:text-error"
      >
        Log out
      </button>
    </form>
  </div>
</AppLayout>
