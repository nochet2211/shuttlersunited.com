---
import AppLayout from "../../layouts/AppLayout.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import Alert from "../../components/ui/Alert.astro";
import Empty from "../../components/ui/Empty.astro";
import { duesStatusFor, listPaymentsFor, listPlans } from "../../lib/queries";
import { isRazorpayConfigured } from "../../lib/razorpay";
import { money, periodLabel, shortDate } from "../../lib/format";
import type { PaymentStatus } from "../../lib/types";

const member = Astro.locals.member!;

const [dues, history, plans] = await Promise.all([
  duesStatusFor(member.id),
  listPaymentsFor(member.id),
  listPlans(),
]);

const paymentsEnabled = isRazorpayConfigured();

// Only rows that represent a real attempt belong in a history table; a bare
// "created" row is an abandoned checkout, not a transaction.
const ledger = history.filter((row) => row.status !== "created");

const statusTone: Record<
  PaymentStatus,
  "success" | "warning" | "error" | "neutral"
> = {
  paid: "success",
  attempted: "warning",
  created: "neutral",
  failed: "error",
  refunded: "neutral",
};

const statusLabel: Record<PaymentStatus, string> = {
  paid: "Paid",
  attempted: "Incomplete",
  created: "Started",
  failed: "Failed",
  refunded: "Refunded",
};
---

<AppLayout
  section="member"
  title="Dues & payments"
  eyebrow="Membership"
  heading="Dues & payments"
  description="Settle your monthly dues and keep every receipt in one place."
>
  <div class="flex flex-col gap-6">
    <div id="pay-alert" hidden>
      <Alert tone="error"><span id="pay-alert-text"></span></Alert>
    </div>

    {
      !paymentsEnabled && (
        <Alert tone="warning">
          Online payments aren't switched on yet. Pay a club admin directly and
          they'll record it against your account.
        </Alert>
      )
    }

    {/* --------------------------------------------------------- this month */}
    <Card padding="lg">
      <div class="flex flex-col gap-5">
        <div class="flex items-center gap-2">
          <h2 class="heading-md">{periodLabel(dues.period)}</h2>
          {
            dues.paid ? (
              <Badge tone="success">Paid</Badge>
            ) : (
              <Badge tone="warning">Outstanding</Badge>
            )
          }
        </div>

        {
          dues.paid ? (
            <p class="text-[14px] leading-5 text-body">
              {money(dues.payment!.amount)} received
              {dues.payment!.paid_at
                ? ` on ${shortDate(dues.payment!.paid_at)}`
                : ""}
              {dues.payment!.razorpay_payment_id
                ? ` · ref ${dues.payment!.razorpay_payment_id}`
                : dues.payment!.method
                  ? ` · ${dues.payment!.method}`
                  : ""}
              .
            </p>
          ) : plans.length === 0 ? (
            <p class="text-[14px] leading-5 text-mute">
              No plans are published yet.
            </p>
          ) : (
            <>
              <p class="text-[14px] leading-5 text-body">
                Choose a plan to settle this month.
              </p>

              <div class="grid gap-3 sm:grid-cols-3">
                {plans.map((plan) => (
                  <div class="flex flex-col gap-3 rounded-lg border border-hairline-soft p-4">
                    <div class="flex flex-col gap-0.5">
                      <span class="text-[14px] font-medium leading-5 text-ink">
                        {plan.name}
                      </span>
                      <span class="heading-md text-ink">
                        {money(plan.amount)}
                      </span>
                    </div>
                    <button
                      type="button"
                      class="pay-button mt-auto h-11 rounded-md bg-primary px-[30px] text-[14px] font-medium leading-5 text-on-primary transition-colors hover:bg-primary-deep disabled:opacity-40"
                      data-plan={plan.id}
                      data-plan-name={plan.name}
                      disabled={!paymentsEnabled}
                    >
                      Pay {money(plan.amount)}
                    </button>
                  </div>
                ))}
              </div>
            </>
          )
        }
      </div>
    </Card>

    {/* ------------------------------------------------------------ history */}
    <section>
      <h2 class="heading-md mb-4">Payment history</h2>

      {
        ledger.length === 0 ? (
          <Empty title="No payments yet">
            Once you settle your first month, every receipt appears here.
          </Empty>
        ) : (
          <div class="overflow-x-auto rounded-lg border border-hairline-soft bg-elevated">
            <table class="w-full min-w-[620px] border-collapse text-left">
              <thead>
                <tr class="border-b border-hairline-soft">
                  {[
                    "Period",
                    "Amount",
                    "Method",
                    "Date",
                    "Reference",
                    "Status",
                  ].map((heading) => (
                    <th class="px-4 py-3 tracking-[0.06em] text-[12px] font-medium uppercase leading-4 text-mute">
                      {heading}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {ledger.map((row) => (
                  <tr class="border-b border-hairline-soft last:border-0">
                    <td class="px-4 py-3 text-[14px] leading-5 text-ink">
                      {row.period ? periodLabel(row.period) : "—"}
                    </td>
                    <td class="px-4 py-3 text-[14px] font-medium leading-5 text-ink">
                      {money(row.amount)}
                    </td>
                    <td class="px-4 py-3 text-[14px] leading-5 text-body">
                      {row.method || "—"}
                    </td>
                    <td class="px-4 py-3 text-[12px] leading-4 text-mute">
                      {row.paid_at ? shortDate(row.paid_at) : "—"}
                    </td>
                    <td class="px-4 py-3 text-[12px] leading-4 text-faint">
                      {row.razorpay_payment_id || "—"}
                    </td>
                    <td class="px-4 py-3">
                      <Badge tone={statusTone[row.status]}>
                        {statusLabel[row.status]}
                      </Badge>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>
  </div>
</AppLayout>

<script>
  import { actions } from "astro:actions";

  const alertBox = document.getElementById("pay-alert");
  const alertText = document.getElementById("pay-alert-text");

  function fail(message: string) {
    if (alertText) alertText.textContent = message;
    if (alertBox) alertBox.hidden = false;
    alertBox?.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  /** Loads Checkout on first use rather than on every page view. */
  function loadCheckout(): Promise<void> {
    if ((window as any).Razorpay) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = "https://checkout.razorpay.com/v1/checkout.js";
      script.onload = () => resolve();
      script.onerror = () =>
        reject(new Error("Could not load the payment window."));
      document.head.appendChild(script);
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    ".pay-button",
  )) {
    button.addEventListener("click", async () => {
      const planId = button.dataset.plan;
      if (!planId) return;

      const original = button.textContent;
      button.disabled = true;
      button.textContent = "Starting…";
      if (alertBox) alertBox.hidden = true;

      try {
        await loadCheckout();

        const { data: order, error } = await actions.payments.createOrder({
          plan: planId,
        });
        if (error || !order)
          throw new Error(error?.message ?? "Could not start the payment.");

        const checkout = new (window as any).Razorpay({
          key: order.keyId,
          amount: order.amount,
          currency: order.currency,
          order_id: order.orderId,
          name: "Shuttlers United",
          description: `${order.planName} membership`,
          prefill: { name: order.memberName, contact: order.memberPhone },
          theme: { color: "#171717" },
          handler: async (response: Record<string, string>) => {
            const { error: confirmError } = await actions.payments.confirm({
              razorpay_order_id: response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature,
            });

            if (confirmError) {
              // The webhook still reconciles this, so don't imply money was lost.
              fail(
                "Your payment went through, but we could not confirm it here. " +
                  "It will update shortly — contact an admin if it does not.",
              );
              return;
            }

            window.location.reload();
          },
          modal: {
            ondismiss: () => {
              button.disabled = false;
              button.textContent = original;
            },
          },
        });

        checkout.on("payment.failed", (event: any) => {
          fail(event?.error?.description ?? "That payment did not go through.");
          button.disabled = false;
          button.textContent = original;
        });

        checkout.open();
      } catch (error) {
        fail(error instanceof Error ? error.message : "Something went wrong.");
        button.disabled = false;
        button.textContent = original;
      }
    });
  }
</script>
