---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import Avatar from "../../components/ui/Avatar.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import Empty from "../../components/ui/Empty.astro";
import Medals from "../../components/ui/Medals.astro";
import { listPublicMembers, medalsByMember } from "../../lib/queries";
import { memberAvatar } from "../../lib/files";
import {
  allMedals,
  byOfficeThenName,
  competitiveLabel,
  haloFor,
} from "../../lib/members";

// Office bearers lead by rank; everyone else stays alphabetical below them.
const [roster, medals] = await Promise.all([
  listPublicMembers(),
  medalsByMember(),
]);
const members = roster.sort(byOfficeThenName);

// Facets are derived from who is actually in the club, so the filter bar never
// offers a category with nothing behind it.
const events = ["MS", "WS", "MD", "WD", "XD"] as const;
const availableEvents = events.filter((event) =>
  members.some((member) => member.preferred_events?.includes(event)),
);

const levels = ["beginner", "intermediate", "advanced", "competitive"] as const;
const availableLevels = levels.filter((level) =>
  members.some((member) => member.skill_level === level),
);

const titleCase = (value: string) => value[0].toUpperCase() + value.slice(1);

// The line under the name: skill level when there is one, otherwise "Member".
// A member with a badge (office or playing level) already has a label, so
// they get no fallback. City is left out — the whole club is in Dimapur.
const subtitle = (member: (typeof members)[number]) =>
  member.skill_level
    ? titleCase(member.skill_level)
    : member.office || member.competes_at
      ? ""
      : "Member";
---

<Layout
  title="Members"
  description="Every member of Shuttlers United — playing style, preferred events, and the gear they use."
>
  <div class="shell">
    <header class="flex flex-col gap-2 border-b border-hairline-soft pb-8">
      <Eyebrow>The roster</Eyebrow>
      <h1 class="heading-lg">Members</h1>
    </header>

    {
      members.length === 0 ? (
        <Empty title="No profiles yet" class="mt-8">
          Members appear here once they join and make their profile public.
        </Empty>
      ) : (
        <>
          {(availableEvents.length > 0 || availableLevels.length > 0) && (
            <div
              class="flex flex-wrap items-center gap-2 py-6"
              role="group"
              aria-label="Filter members"
            >
              <button
                type="button"
                data-filter="all"
                aria-pressed="true"
                class="filter-pill rounded-full bg-lift px-3 py-1.5 text-[14px] pointer-coarse:py-2.5 font-medium leading-5 text-ink transition-colors"
              >
                All
              </button>
              {availableEvents.map((event) => (
                <button
                  type="button"
                  data-filter={`event:${event}`}
                  aria-pressed="false"
                  class="filter-pill rounded-full px-3 py-1.5 text-[14px] pointer-coarse:py-2.5 leading-5 text-mute transition-colors hover:bg-soft hover:text-ink"
                >
                  {event}
                </button>
              ))}
              {availableLevels.map((level) => (
                <button
                  type="button"
                  data-filter={`level:${level}`}
                  aria-pressed="false"
                  class="filter-pill rounded-full px-3 py-1.5 text-[14px] pointer-coarse:py-2.5 leading-5 text-mute transition-colors hover:bg-soft hover:text-ink"
                >
                  {titleCase(level)}
                </button>
              ))}
            </div>
          )}

          <div
            id="roster"
            class="grid gap-4 pb-4 sm:grid-cols-2 lg:grid-cols-3"
          >
            {/* min-w-0 lets the grid track clamp each card: without it the
                automatic minimum size holds every card as wide as the longest
                un-wrapped name in the roster. */}
            {members.map((member) => (
              <article
                class="player-card min-w-0"
                data-events={(member.preferred_events ?? []).join(",")}
                data-level={member.skill_level ?? ""}
              >
                <Card
                  href={`/members/${member.slug}`}
                  padding="md"
                  class="card-gradient h-full"
                >
                  <div class="flex h-full flex-col justify-center gap-4">
                    <div class="flex items-center gap-3">
                      <Avatar
                        name={member.name}
                        src={memberAvatar(member)}
                        size="lg"
                        halo={haloFor(member)}
                      />
                      <div class="flex min-w-0 flex-col gap-0.5">
                        <p class="heading-md truncate">{member.name}</p>
                        {(member.office || member.competes_at) && (
                          <div class="my-0.5 flex flex-wrap gap-1">
                            {member.office && (
                              <Badge
                                tone="bare"
                                class="border-gold bg-gold-tint text-ink"
                              >
                                {member.office}
                              </Badge>
                            )}
                            {member.competes_at && (
                              <Badge
                                tone="bare"
                                class="border-pro bg-pro-tint text-ink"
                              >
                                {competitiveLabel(member.competes_at)}
                              </Badge>
                            )}
                          </div>
                        )}
                        {subtitle(member) && (
                          <p class="truncate text-[14px] leading-5 text-mute">
                            {subtitle(member)}
                          </p>
                        )}
                        {/* PocketBase returns an unset number as 0, so 0 means none. */}
                        {Boolean(member.jersey_number) && (
                          <p class="text-[12px] leading-4 text-faint">
                            #{member.jersey_number}
                          </p>
                        )}
                      </div>
                      {/* Pinned top-right, clear of the name, so a card with
                          medals keeps the same text alignment as one without. */}
                      <Medals
                        wins={allMedals(
                          medals.get(member.id) ?? [],
                          member.honours,
                        )}
                        grouped
                        align="end"
                        class="ml-auto shrink-0 self-start"
                      />
                    </div>

                    {member.bio && (
                      <p class="line-clamp-2 text-[14px] leading-5 text-body">
                        {member.bio}
                      </p>
                    )}

                    {/* Only when there is something to show: an empty row still
                        takes the flex gap and leaves dead space under the name. */}
                    {(member.preferred_events?.length || member.handedness) && (
                      <div class="mt-auto flex flex-wrap items-center gap-1.5">
                        {member.preferred_events?.map((event) => (
                          <Badge>{event}</Badge>
                        ))}
                        {member.handedness && (
                          <Badge tone="neutral">
                            {titleCase(member.handedness)}-handed
                          </Badge>
                        )}
                      </div>
                    )}
                  </div>
                </Card>
              </article>
            ))}
          </div>

          <p
            id="roster-empty"
            hidden
            class="py-12 text-center text-[14px] leading-5 text-mute"
          >
            No members match that filter.
          </p>
        </>
      )
    }
  </div>
</Layout>

<script>
  // Client-side filtering: the roster is small enough that a round trip per
  // filter click would be slower than the DOM work.
  const pills = document.querySelectorAll<HTMLButtonElement>(".filter-pill");
  const cards = document.querySelectorAll<HTMLElement>(".player-card");
  const empty = document.getElementById("roster-empty");

  // Selected = surface lift, per {components.pricing-tab-selected}.
  const ACTIVE = ["bg-lift", "font-medium", "text-ink"];
  const IDLE = ["text-mute", "hover:bg-soft", "hover:text-ink"];

  function apply(filter: string) {
    let visible = 0;

    for (const card of cards) {
      let matches = filter === "all";

      if (!matches) {
        const [kind, value] = filter.split(":");
        matches =
          kind === "event"
            ? (card.dataset.events ?? "").split(",").includes(value)
            : card.dataset.level === value;
      }

      card.hidden = !matches;
      if (matches) visible++;
    }

    if (empty) empty.hidden = visible > 0;
  }

  for (const pill of pills) {
    pill.addEventListener("click", () => {
      for (const other of pills) {
        const isTarget = other === pill;
        other.setAttribute("aria-pressed", String(isTarget));
        other.classList.remove(...ACTIVE, ...IDLE);
        other.classList.add(...(isTarget ? ACTIVE : IDLE));
      }
      apply(pill.dataset.filter ?? "all");
    });
  }
</script>
