---
import Layout from "../../layouts/Layout.astro";
import Eyebrow from "../ui/Eyebrow.astro";

interface Props {
  title: string;
  eyebrow: string;
  updated: string;
}

const { title, eyebrow, updated } = Astro.props;
---

<Layout title={title}>
  <div class="shell max-w-[760px]">
    <header class="flex flex-col gap-2 border-b border-hairline-soft pb-8">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h1 class="heading-lg">{title}</h1>
      <p class="eyebrow">
        Last updated {updated}
      </p>
    </header>

    <div class="prose-legal flex flex-col gap-6 py-10">
      <slot />
    </div>
  </div>
</Layout>

<style>
  /* Scoped to legal copy: long-form prose the rest of the site never uses. */
  .prose-legal :global(h2) {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-ink);
    margin-top: 8px;
  }
  .prose-legal :global(p),
  .prose-legal :global(li) {
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.16px;
    color: var(--color-body);
  }
  .prose-legal :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 20px;
    list-style: disc;
  }
  .prose-legal :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-legal :global(a:hover) {
    color: var(--color-link-deep);
  }
  .prose-legal :global(code) {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink);
    background: var(--color-soft);
    padding: 1px 5px;
    border-radius: 4px;
  }
</style>
