---
import Logo from "./Logo.astro";

const groups = [
  {
    title: "Club",
    links: [
      { href: "/members", label: "Members" },
      { href: "/tournaments", label: "Tournaments" },
    ],
  },
  {
    title: "Members",
    links: [
      { href: "/dashboard", label: "Dashboard" },
      { href: "/dashboard/payments", label: "Payment history" },
      { href: "/login", label: "Log in" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/terms", label: "Terms" },
      { href: "/privacy", label: "Privacy" },
      { href: "/refunds", label: "Refunds" },
      { href: "/contact", label: "Contact" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline-soft bg-canvas">
  <div class="shell py-16">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div class="flex flex-col gap-3">
        <Logo class="min-h-10 pointer-coarse:min-h-11" />
        <p class="max-w-xs text-[14px] leading-[1.43] text-mute">
          A badminton club in Dimapur, Nagaland. Weekday drills, weekend
          matches, and a fixture list we actually keep up to date.
        </p>
      </div>

      {
        groups.map((group) => (
          <div class="flex flex-col gap-3">
            <p class="text-[14px] font-medium leading-[1.43] text-ink">
              {group.title}
            </p>
            <ul class="flex flex-col gap-2">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[14px] leading-[1.43] text-mute transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-hairline-soft pt-6 text-[12px] leading-[1.33] text-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Shuttlers United. All rights reserved.</p>
      <p>Payments processed securely by Razorpay.</p>
    </div>
  </div>
</footer>
