---
/**
 * The wordmark: a shuttlecock drawn at the same line weight as the rest of the
 * system, so it reads as part of the page rather than a pasted-on badge. It
 * takes its colour from the ink token, so it inverts with the theme.
 */
interface Props {
  class?: string;
  compact?: boolean;
  /** Utilities applied to the wordmark, so a caller can hide it responsively. */
  labelClass?: string;
}
const { class: className, compact = false, labelClass } = Astro.props;
---

<a
  href="/"
  class:list={["group inline-flex items-center gap-2 text-ink", className]}
  aria-label="Shuttlers United — home"
>
  <svg
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="shrink-0"
  >
    <!-- Cork -->
    <circle cx="12" cy="18.75" r="3.1" fill="currentColor" stroke="none"
    ></circle>
    <!-- Feather skirt -->
    <path d="M9.4 17 4.6 6.2"></path>
    <path d="M12 15.65V3.2"></path>
    <path d="M14.6 17 19.4 6.2"></path>
    <path d="M10.6 16.2 7.2 4.6"></path>
    <path d="M13.4 16.2 16.8 4.6"></path>
    <!-- Skirt rim -->
    <path d="M5.6 8.4c3.9 2 8.9 2 12.8 0" opacity="0.45"></path>
  </svg>

  {
    !compact && (
      <span class:list={["text-[16px] font-medium", labelClass]}>
        Shuttlers United
      </span>
    )
  }
</a>
