---
/**
 * The club crest beside the wordmark. The crest is the official round badge,
 * cropped to a transparent PNG in /public; it keeps its own colours in both
 * themes. The wordmark is the club's domain in a geometric face, in the crest
 * blue, switching to the ink in the dark theme.
 */
interface Props {
  class?: string;
  compact?: boolean;
  /** Utilities applied to the wordmark, so a caller can hide it responsively. */
  labelClass?: string;
}
const { class: className, compact = false, labelClass } = Astro.props;
---

<a
  href="/"
  class:list={["group inline-flex items-center gap-2 text-ink", className]}
  aria-label="Shuttlers United — home"
>
  <img
    src="/logo.png"
    alt=""
    width="36"
    height="36"
    class="size-9 shrink-0 rounded-full"
    decoding="async"
  />

  {
    !compact && (
      <span
        class:list={[
          "font-crest font-semibold leading-none tracking-[-0.02em] text-crest",
          labelClass ?? "text-[19px]",
        ]}
      >
        shuttlersunited<span class="text-mute">.com</span>
      </span>
    )
  }
</a>
