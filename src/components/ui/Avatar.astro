---
/**
 * Profile picture with an initials fallback — the placeholder every member
 * starts with before they upload anything. Office bearers wear a gold halo,
 * competitive players a crest-blue one (DESIGN.md, Deviation 8).
 */
import { initials } from "../../lib/format";

interface Props {
  name: string;
  src?: string | null;
  size?: "sm" | "md" | "lg" | "xl";
  /** A ring marking an office bearer (gold) or a competitive player (crest blue). */
  halo?: "office" | "pro";
  class?: string;
}

const { name, src, size = "md", halo, class: className } = Astro.props;

const sizes = {
  sm: "size-7 text-[12px]",
  md: "size-10 text-[13px]",
  lg: "size-16 text-[20px]",
  xl: "size-24 text-[28px]",
};
---

<div
  class:list={[
    "relative shrink-0 overflow-hidden rounded-full border border-hairline-soft bg-soft",
    sizes[size],
    // An outline rather than a ring: its offset gap is see-through, so the
    // halo floats clear of the photo on any surface, hover states included.
    halo && "outline-2 outline-offset-2",
    halo === "office" && "outline-gold",
    halo === "pro" && "outline-pro",
    className,
  ]}
>
  {
    src ? (
      <img
        src={src}
        alt=""
        width="256"
        height="256"
        loading="lazy"
        decoding="async"
        class="size-full object-cover"
      />
    ) : (
      <span
        class="flex size-full items-center justify-center font-medium text-mute"
        aria-hidden="true"
      >
        {initials(name)}
      </span>
    )
  }
</div>
