---
/**
 * Prize distribution. Places carry a medal tint for the top three — the one
 * place on the site where colour is doing the reading for you — and everything
 * below is plain rows.
 */
import { money } from "../../lib/format";
import { EVENT_NAMES } from "../../lib/tournament";
import type { PrizeSlot } from "../../lib/types";

interface Props {
  slots: PrizeSlot[];
  total?: number;
}

const { slots, total } = Astro.props;

// Medal tints are keyed off the leading digit so"1st","1","Winner" and
// "1st–2nd" all land on gold without a lookup table per wording.
function medal(place: string): string {
  const rank = place.trim().match(/^(\d+)/)?.[1];
  if (rank === "1" || /winner|champion/i.test(place)) return "gold";
  if (rank === "2" || /runner/i.test(place)) return "silver";
  if (rank === "3" || /semi|third/i.test(place)) return "bronze";
  return "none";
}

const medalStyles: Record<string, string> = {
  gold: "border-l-[3px] border-l-gold bg-gold-tint",
  silver: "border-l-[3px] border-l-silver bg-silver-tint",
  bronze: "border-l-[3px] border-l-bronze bg-bronze-tint",
  none: "border-l-[3px] border-l-transparent",
};

const showEvent = slots.some((slot) => slot.event);
---

<div class="overflow-x-auto rounded-lg border border-hairline-soft bg-elevated">
  <table class="w-full border-collapse text-left">
    <thead>
      <tr class="border-b border-hairline-soft">
        <th
          class="px-4 py-3 tracking-[0.06em] text-[12px] font-medium uppercase leading-4 text-mute"
        >
          Place
        </th>
        {
          showEvent && (
            <th class="px-4 py-3 tracking-[0.06em] text-[12px] font-medium uppercase leading-4 text-mute">
              Event
            </th>
          )
        }
        <th
          class="px-4 py-3 text-right tracking-[0.06em] text-[12px] font-medium uppercase leading-4 text-mute"
        >
          Prize
        </th>
      </tr>
    </thead>
    <tbody>
      {
        slots.map((slot) => (
          <tr
            class:list={[
              "border-b border-hairline-soft last:border-0",
              medalStyles[medal(slot.place)],
            ]}
          >
            <td class="px-4 py-3">
              <span class="text-[14px] font-medium leading-5 text-ink">
                {slot.place}
              </span>
              {slot.note && (
                <span class="block text-[12px] leading-4 text-mute">
                  {slot.note}
                </span>
              )}
            </td>
            {showEvent && (
              <td class="px-4 py-3 text-[12px] leading-4 text-body">
                {slot.event ? EVENT_NAMES[slot.event] : "—"}
              </td>
            )}
            <td class="px-4 py-3 text-right text-[14px] leading-5 text-ink">
              {money(slot.amount)}
            </td>
          </tr>
        ))
      }
    </tbody>
    {
      total ? (
        <tfoot>
          <tr class="border-t border-hairline-soft bg-soft">
            <td
              class="px-4 py-3 text-[14px] font-medium leading-5 text-body"
              colspan={showEvent ? 2 : 1}
            >
              Total
            </td>
            <td class="px-4 py-3 text-right text-[14px] font-medium leading-5 text-ink">
              {money(total)}
            </td>
          </tr>
        </tfoot>
      ) : null
    }
  </table>
</div>
