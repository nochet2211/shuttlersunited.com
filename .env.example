# --- PocketBase ---------------------------------------------------------
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@shuttlersunited.com
POCKETBASE_ADMIN_PASSWORD=change-me-please

# --- Secrets ------------------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_COOKIE_SECRET=
# Long-lived. Rotating this locks every member out until passwords are
# re-derived, so treat it as permanent.
MEMBER_PASSWORD_SECRET=

# --- WhatsApp OTP (Gupshup) --------------------------------------------
# Leave blank in development: OTPs are printed to the server log instead.
GUPSHUP_API_KEY=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_APP_NAME=
GUPSHUP_OTP_TEMPLATE_ID=

# --- Razorpay -----------------------------------------------------------
# Leave blank to disable online payments (admins can still record cash/UPI).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
