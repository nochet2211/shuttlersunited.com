{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuttlersunited",
  // The adapter fills in `main` and the ASSETS / IMAGES bindings at build time.
  "compatibility_date": "2026-11-20",
  // node:crypto (cookie signing, OTP hashing, Razorpay signatures) and Buffer.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "shuttlersunited.com", "custom_domain": true },
    { "pattern": "www.shuttlersunited.com", "custom_domain": true }
  ],
  // Off: the site lives only on the custom domains. Left on, every deploy
  // would re-enable the *.workers.dev address and its preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // The club's data. Schema in migrations/; apply with `npm run db:migrate`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shuttlersunited",
      "database_id": "608800f2-82ba-4221-99fd-078d814453cd",
      "migrations_dir": "migrations"
    }
  ],
  // Uploads (avatars, post covers and attachments), served by /files/[...path].
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "shuttlersunited-files" }]
}
