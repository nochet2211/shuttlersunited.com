{
  "name": "shuttlersunited.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "db:migrate": "wrangler d1 migrations apply shuttlersunited --local",
    "db:migrate:remote": "wrangler d1 migrations apply shuttlersunited --remote",
    "db:import": "node scripts/import-pocketbase.mjs --local",
    "db:import:remote": "node scripts/import-pocketbase.mjs --remote",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.168.0"
  }
}
